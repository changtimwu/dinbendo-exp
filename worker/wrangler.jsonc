{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dinbendon-itsi",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "account_id": "15bfe332876061d9a548a4f3d6835657",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "dinbendon.itsi.xyz",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dinbendon-shops",
      "database_id": "b0e2be4f-0861-434e-8efc-0dd2f01160f4"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
